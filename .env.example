# =============================================================================
# TrustLogix POC — local agent environment template
# Copy this to .env and fill in the values. See README.md for a step-by-step
# walkthrough of where each value comes from.
# =============================================================================

# =============================================================================
# 1. Identity provider — "entra" or "okta"
#    Controls which IdP is used for Phase 1 (user login). Phase 2 (the TLX
#    gateway) discovers its own authorization server via PRM and picks
#    matching credentials automatically — so even when AUTH_IDP=entra you
#    can still leave Okta credentials configured (and vice versa) if your
#    gateway happens to advertise the other IdP.
# =============================================================================
AUTH_IDP=entra

# --- Microsoft Entra ID (fill in if you use Entra) ---
# App registration must have:
#   Redirect URI (Web): http://localhost:5000/auth/callback
#   ID tokens enabled
#   Permissions: openid, profile, email, offline_access
ENTRAID_TENANT_ID=                       # Directory (tenant) ID
ENTRAID_CLIENT_ID=                       # Application (client) ID
ENTRAID_CLIENT_SECRET=                   # Client secret VALUE (not the ID)
ENTRAID_REDIRECT_URI=http://localhost:5000/auth/callback
ENTRAID_API_SCOPE=                       # leave empty unless your gateway requires a custom API scope

# --- Okta (fill in if you use Okta) ---
# App settings must have:
#   Sign-in redirect URI: http://localhost:5000/auth/callback
#   Grant type: Authorization Code
#   Scopes: openid, profile, email
OKTA_DOMAIN=                             # e.g. dev-12345.okta.com
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_AUTH_SERVER_ID=default              # "default" or a custom auth server ID

# =============================================================================
# 2. TrustLogix MCP gateway
#    The gateway URL provisioned for your POC. Provided by your TrustLogix
#    contact. The agent talks ONLY to the gateway — it never calls Snowflake
#    directly, so no Snowflake credentials are needed here.
# =============================================================================
TLX_MCP_URL=                             # e.g. https://mcpgateway.trustlogix.io/mcp
TRUSTLOGIX_MCP_TIMEOUT=30                # seconds to wait for gateway responses

# Snowflake role label shown in the chat header so the user can see which
# gateway service identity their queries run as. Display only — does not
# affect routing or auth.
TLX_GW_SERVICE_ROLE=POC_GW_SVC

# =============================================================================
# 3. Session encryption
#    Required. Generate once and keep stable across restarts:
#      python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
SESSION_SECRET=

# Set to true when running behind TLS so cookies require HTTPS.
SECURE_COOKIES=false

# =============================================================================
# 4. LLM
#    "anthropic" is recommended for the simplest setup (one API key, no GPU).
#    "ollama" runs a local model in the bundled Docker container — slower on
#    CPU, no API key required.
# =============================================================================
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=                       # required when LLM_PROVIDER=anthropic
OLLAMA_BASE_URL=http://ollama:11434      # leave as-is when LLM_PROVIDER=ollama

# =============================================================================
# 5. Optional
# =============================================================================

# Branding chip shown in the chat header. Leave empty to hide.
CUSTOMER_LABEL=

# NVIDIA NeMo guardrails (input/output safety rails). Optional.
NVIDIA_API_KEY=

# LangSmith tracing — useful for debugging the agent's tool calls. Optional.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tlx-poc
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
